# ============================================
# SATŪS — Environment Variables
# ============================================
# Copy to .env.local:   cp .env.example .env.local
#
# Nothing here is required to boot the starter. Every integration is optional
# and self-disables when its env vars are absent. To add one:
#
#   • Scaffold env vars:   bun run setup:project
#   • Full list + types:   lib/env.ts          (Zod-validated source of truth)
#   • Per-integration:     lib/integrations/<name>/README.md
#                          (shopify · hubspot · mailchimp)
# ============================================

# Public site URL — SEO, canonical URLs, OG images, sitemap, robots.
# dev: http://localhost:3000   ·   prod: https://your-domain.com
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# --------------------------------------------
# Payload CMS (required — admin panel + blog)
# --------------------------------------------
# Postgres connection string. Dev: Neon dev branch (https://console.neon.tech)
# or local Postgres. Prod: Neon via Vercel Marketplace.
DATABASE_URL="postgresql://user:password@host:5432/dbname"
# Long random string used to sign auth tokens: `openssl rand -hex 32`
PAYLOAD_SECRET=""

# Manual cache revalidation: POST /api/revalidate?tag=case-studies with an
# `x-revalidate-secret` header. Needed when a maintenance script writes straight
# to the database, where Payload's revalidation hooks cannot reach the cache.
# REVALIDATE_SECRET=""
# Vercel Blob media storage (Vercel → Storage → Blob).
#
# LEAVE BLOB_READ_WRITE_TOKEN UNSET LOCALLY. payload.config.ts enables the Blob
# plugin whenever it is set, and development and production share one store — so
# a token in .env.local sends every local upload straight into production media.
# Without it the app boots and uploads fall back to local disk, which is what you
# want for dev.
#
# Keep the real token under the _PROD name instead. The scripts that legitimately
# write to production (`--prod` on apply-case-study-imagery, refresh-case-study-logos,
# apply-final-verification-imagery) map it onto BLOB_READ_WRITE_TOKEN for their own
# process only — the same discipline DATABASE_URL_PROD follows.
# BLOB_READ_WRITE_TOKEN_PROD=""

# --------------------------------------------
# Contact form email (optional — /kontakt delivery)
# --------------------------------------------
# Resend API for delivering /kontakt submissions to the team inbox. Absent →
# the page renders but the submit fails gracefully (error state + server log),
# never throws. The API key comes from https://resend.com/api-keys — a
# sending-only key is enough here (and is all the app should hold). EMAIL_FROM
# must be an address on a domain verified in Resend (Domains → status
# "verified"), or every send is rejected. The mailbox itself need not exist —
# replies go to the submitter via Reply-To. CONTACT_INBOX is the destination.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="formularz@sociallama.pl"
# CONTACT_INBOX="halohalo@sociallama.pl"
# Careers applications (with the CV attached) go here instead, so candidate
# documents stay out of the sales-lead inbox. Unset falls back to CONTACT_INBOX.
# CAREERS_INBOX="rekrutacja@sociallama.pl"

# --------------------------------------------
# Cloudflare Turnstile (optional — /kontakt spam check)
# --------------------------------------------
# Both keys come from the same widget: Cloudflare dashboard → Turnstile → your
# widget. Set BOTH or NEITHER in production — the two halves fail differently
# and a half-configured pair hard-blocks the form:
#   secret missing    → fails open in development, fails CLOSED in production
#   site key missing  → no widget renders, so no token is submitted, which in
#                       production the secret then rejects (400 on every send)
# The site key is NEXT_PUBLIC, i.e. inlined at build time: after adding it on
# Vercel you must redeploy, and locally you must restart the dev server.
# NEXT_PUBLIC_CLOUDFLARE_TURNSTILE_SITE_KEY="0x4AAAAAAA..."
# CLOUDFLARE_TURNSTILE_SECRET_KEY="0x4AAAAAAA..."

# --------------------------------------------
# Google Analytics 4 (optional — PRODUCTION ONLY by design)
# --------------------------------------------
# GA4 measurement id (`G-XXXXXXXXXX`). Set this ONLY on Vercel Production.
#
# That is the gate. There is no VERCEL_ENV branching anywhere in the code:
# <GoogleAnalytics> renders if and only if this is present, so a local dev
# server or a preview deployment physically cannot reach the property. Leaving
# it unset here is the correct state for `.env.local` — do not copy it across.
#
# The consent mechanism does NOT depend on it: the banner, the settings panel
# and the sl_consent cookie all work without a measurement id. There is simply
# nothing to grant consent to, which is also why the e2e suite's "_ga appears
# after accepting" assertion skips itself unless this is set.
#
# GA4 is gated behind consent (Google Consent Mode v2, defaulting to denied).
# See lib/consent/ and openspec/specs/web-analytics.
# NEXT_PUBLIC_GOOGLE_ANALYTICS="G-XXXXXXXXXX"
#
# Google Tag Manager container (production only, same gating). The container
# loads behind the same denied Consent Mode defaults, so every tag inside it
# is governed by the visitor's decision. See lib/consent/google-tag-manager.tsx.
# NEXT_PUBLIC_GOOGLE_TAG_MANAGER_ID="GTM-XXXXXXX"

# Storybook proxy (optional, Preview only). When set, /storybook on this domain
# proxies to your standalone Storybook deployment (build it with
# `bun run build-storybook`, output `storybook-static`). Leave UNSET in
# Production — the route is force-disabled there regardless. For local dev, run
# `bun storybook` and use http://localhost:6006 directly.
# NEXT_PUBLIC_STORYBOOK_URL="https://your-storybook.vercel.app"
