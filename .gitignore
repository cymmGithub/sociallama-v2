# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js
.turbo

# testing
/coverage
/test-results/
/playwright-report/
/playwright/.cache/
/blob-report/
/.playwright-mcp/

# next.js
/.next/
/out/

# TypeScript
*.tsbuildinfo

# production
/build
/public/sw.js

# misc
.DS_Store
*.pem
.cursor/scratchpad.md

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# vercel
.vercel

# tldr
.tldr

.eslintcache

# Windows crash dumps
*.exe.stackdump

.env*.local

.npmrc

*storybook.log
storybook-static
certificates

next-env.d.ts
# claude
.claude
plans

# react-doctor — ignore generated diagnostics, keep the curated suppression list
.react-doctor/*
!.react-doctor/false-positives.md

# prepare-handoff backup — created by `bun run handoff` when swapping README
README.original.md
media/
.env*

# Per-worktree runtime state written by lib/scripts/worktree.ts
.worktree-meta.json
.worktree-dev.log

# Local working screenshots / scratch notes (not repo assets)
/*.jpeg
/*.jpg
/*.png
/perf-impro-suggestions.md

# Case-study import pipeline — staging & source-deck mirrors (see openspec/changes/import-case-study-decks)
# Extraction output is disposable; only chosen assets under public/ and the scripts/import data are tracked.
/content/case-studies/

# Case-study pipeline scratch (generated by triage/skim/extract runs)
scripts/case-studies/.skim.tsv

# Python bytecode from the asset pipelines (scripts/client-logos, assets-src/*)
__pycache__/
*.pyc
scripts/case-studies/.remaining.txt
scripts/case-studies/.extract.log
